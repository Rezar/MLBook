    "# Cell 15: Hyperparameter Experimentation Example\n",
    "def quick_experiment(hidden_sizes, lr, episodes=200):\n",
    "    \"\"\"Run a quick experiment with different hyperparameters\"\"\"\n",
    "    \n",
    "    agent = DQNAgent(\n",
    "        state_size=state_size,\n",
    "        action_size=action_size,\n",
    "        lr=lr,\n",
    "        hidden_sizes=hidden_sizes,\n",
    "        q_calculator=DQNCalculator()\n",
    "    )\n",
    "    \n",
    "    scores, _, _ = train_agent(agent, env, episodes=episodes)\n",
    "    final_performance = np.mean(scores[-50:])  # Last 50 episodes\n",
    "    \n",
    "    return final_performance\n",
    "\n",
    "# Test different architectures\n",
    "print(\"Hyperparameter Experiments:\")\n",
    "print(\"=\" * 40)\n",
    "\n",
    "experiments = [\n",
    "    ([64, 64], 1e-3),\n",
    "    ([128, 128], 1e-3),\n",
    "    ([256, 128, 64], 1e-3),\n",
    "    ([128, 128], 5e-4),\n",
    "    ([128, 128], 1e-4),\n",
    "]\n",
    "\n",
    "results = []\n",
    "for hidden_sizes, lr in experiments:\n",
    "    performance = quick_experiment(hidden_sizes, lr)\n",
    "    results.append((hidden_sizes, lr, performance))\n",
    "    print(f\"Architecture: {hidden_sizes}, LR: {lr} -> Score: {performance:.2f}\")\n",
    "\n",
    "# Find best configuration\n",
    "best_config = max(results, key=lambda x: x[2])\n",
    "print(f\"\\nBest configuration:\")\n",
    "print(f\"Hidden sizes: {best_config[0]}, Learning rate: {best_config[1]}, Score: {best_config[2]:.2f}\")\n",
    "\n",
    "env.close()\n",
    "print(\"\\nExperiments completed!\")"
   ]
  }
